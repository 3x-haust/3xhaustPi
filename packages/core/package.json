{
  "name": "@3xhaust/core",
  "version": "0.1.0",
  "description": "Harness-neutral deterministic recipe and policy core for 3xhaustPi",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "clean": "shx rm -rf dist",
    "build": "tsgo -p tsconfig.build.json",
    "test": "vitest --run",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "dependencies": {
    "@3xhaust/semantic-contract": "0.1.0"
  },
  "devDependencies": {
    "shx": "0.4.0",
    "vitest": "4.1.9"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3x-haust/3xhaustPi.git",
    "directory": "packages/core"
  }
}
