{
  "name": "@3xhaust/pi-session",
  "version": "0.1.0",
  "description": "Fail-closed Pi session bridge for the 3xhaustPi desktop runtime",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "benchmark",
    "LICENSE"
  ],
  "scripts": {
    "clean": "shx rm -rf dist",
    "build": "tsgo -p tsconfig.build.json",
    "benchmark": "npm run build && node benchmark/session-benchmark.mjs",
    "test": "vitest --run",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "dependencies": {
    "@3xhaust/semantic-contract": "0.1.0",
    "@earendil-works/pi-agent-core": "0.82.1",
    "@earendil-works/pi-ai": "0.82.1"
  },
  "devDependencies": {
    "shx": "0.4.0",
    "vitest": "4.1.9"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3x-haust/3xhaustPi.git",
    "directory": "packages/pi-session"
  }
}
